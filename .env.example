# Environment Configuration Template for Electrical Machines Digital Twin Lab
# Copy this file to .env and configure appropriate values for your environment.

# Server Configuration
PORT=5000
HOST=0.0.0.0
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Database Configuration (MongoDB Atlas or local fallback)
# If MONGODB_URI is not set or unreachable, the system automatically falls back to local SQLite/in-memory storage
MONGODB_URI=
DB_NAME=electrical_machines_db

# External API Integrations (Optional)
# NVIDIA LLM API key for AI improvement workflow
NVIDIA_API_KEY=

# GitHub Personal Access Token for remote repository operations (Never hardcode in source files)
GITHUB_PAT=
GITHUB_REPO=siddardhvanguri-source/digital_machine-s_laboratory-
